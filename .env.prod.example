# Welfare Platform - Variables d'environnement pour la production sur VPS

# Base de données
POSTGRES_USER=welfare
POSTGRES_PASSWORD=welfare_super_secret_password
POSTGRES_DB=welfare_db

# Meilisearch
MEILISEARCH_API_KEY=votre_cle_meilisearch_master_tres_longue_ici
# Clé "search" seule sur l'index products : c'est elle qui part dans le navigateur (barre de recherche).
# Jamais la clé master. Générée par scripts/meili-search-key.sh (à relancer après chaque changement de master).
MEILISEARCH_SEARCH_KEY=cle_generee_par_scripts_meili-search-key

# Medusa API
JWT_SECRET=super_secret_jwt_a_changer
COOKIE_SECRET=super_secret_cookie_a_changer

# URLs de votre domaine (à changer)
STORE_URL=https://shop.votredomaine.com
ADMIN_URL=https://admin.votredomaine.com
MEDUSA_BACKEND_URL=https://api.votredomaine.com

# PostHog (onglet Analytics du dashboard admin) — clé API personnelle,
# jamais la clé publique phc_... utilisée côté storefront
POSTHOG_PERSONAL_API_KEY=phx_votre_cle_personnelle_posthog
POSTHOG_PROJECT_ID=616113

# Blog — secret partagé entre admin et storefront pour les écritures
# (création/édition/suppression d'articles). Générez une vraie valeur
# aléatoire longue ; ne jamais réutiliser une valeur par défaut connue.
ADMIN_BLOG_KEY=une_valeur_aleatoire_longue_a_generer

# WhatsApp Cloud API (Meta, en direct — pas de BSP type Twilio) pour les
# codes OTP (vérification à l'inscription + connexion sans mot de passe).
# Nécessite : un compte Meta Business + WABA vérifiée, un numéro dédié à
# l'API WhatsApp Business, un template "Authentication" approuvé par Meta
# (variable unique = le code, bouton natif "Copier le code"), et un token
# System User longue durée avec le Phone Number ID associé.
WHATSAPP_ACCESS_TOKEN=votre_token_system_user_whatsapp
WHATSAPP_PHONE_NUMBER_ID=votre_phone_number_id_whatsapp
WHATSAPP_OTP_TEMPLATE_NAME=otp_code
WHATSAPP_API_VERSION=v21.0
# true = logge les codes OTP dans les logs du conteneur api au lieu de les
# envoyer par WhatsApp. Tant que la WABA n'est pas configurée ci-dessus,
# laissez à true (c'est aussi la valeur par défaut dans docker-compose.prod.yml
# si cette ligne est absente du .env) — sinon chaque inscription/connexion par
# code échouera avec une erreur serveur. Repassez à false une fois la WABA prête :
# sans ça, personne (même vous) ne peut recevoir de vrai code par WhatsApp.
WHATSAPP_DEBUG_LOG=true
